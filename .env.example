# --- Claude -------------------------------------------------------------------
# Create once on your own machine with `claude setup-token` (Pro/Max subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: pin a model, e.g. claude-sonnet-5-5 (empty = Claude Code default)
# CLAUDE_MODEL=

# --- Podcast ------------------------------------------------------------------
# PODCAST_NAME=Paper Podcast
# HOST_NAME=Lena
# EXPERT_NAME=Dr. Jonas
# WORDS_PER_MINUTE=140

