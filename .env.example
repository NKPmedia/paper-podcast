# --- Claude -------------------------------------------------------------------
# Create once on your own machine with `claude setup-token` (Pro/Max subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# Models per role: alias (haiku, sonnet, opus) or a full model ID
# RESEARCH_SCOUT_MODEL=haiku
# RESEARCH_MAIN_MODEL=opus
# SCRIPT_MODEL=opus

# --- Paper downloads -----------------------------------------------------------
# DOWNLOAD_MAX_MB=20
# DOWNLOAD_TIMEOUT_S=60
# PAPER_MAX_CHARS=250000

# --- Web UI -------------------------------------------------------------------
# Create with: docker compose run --rm app python -m app.cli hash-password
WEB_PASSWORD_HASH=
# Optional; generated and stored in ./data/session_secret when empty
# SESSION_SECRET=
# Only set to false for plain-http testing without the reverse proxy
# COOKIE_SECURE=true
# TIMEZONE=Europe/Berlin

# --- Telegram bot (optional) -----------------------------------------------------
# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Your chat ID(s), comma-separated. Leave empty at first: the bot then replies with your ID.
TELEGRAM_ALLOWED_CHAT_IDS=
# Also announce and send episodes started from the web UI
# TELEGRAM_NOTIFY_ALL=true
# Base URL of this server, used for "open in browser" links in messages
# PUBLIC_BASE_URL=https://podcast.example.org
# Optional self-hosted Bot API server (allows audio files larger than 50 MB)
# TELEGRAM_API_BASE_URL=

# --- Podcast feed ---------------------------------------------------------------
# The feed URL is shown on the "Verbindungen" page. Empty = random token stored in ./data/feed_token
# FEED_TOKEN=

# --- REST API + webhooks (disabled while empty) -----------------------------------
# API_TOKEN=            # e.g. openssl rand -hex 32

# --- Email notifications (disabled while SMTP_HOST or EMAIL_TO is empty) -----------
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls | ssl | none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# EMAIL_TO=me@example.org
# EMAIL_EVENTS=done,failed
# EMAIL_ATTACH_AUDIO=false

# --- Podcast ------------------------------------------------------------------
# PODCAST_NAME=Paper Podcast
# HOST_NAME=Lena
# EXPERT_NAME=Dr. Jonas
# WORDS_PER_MINUTE=140

# --- Edge TTS (free, no key) ----------------------------------------------------
# EDGE_VOICE_HOST=de-DE-SeraphinaMultilingualNeural
# EDGE_VOICE_EXPERT=de-DE-FlorianMultilingualNeural
# EDGE_CONCURRENCY=3
# EDGE_PROXY=

# --- Audio --------------------------------------------------------------------
# TARGET_LUFS=-16
# MP3_BITRATE=96k
# Optional files in ./data/assets/: intro.mp3, outro.mp3, cover.jpg
